{
  "module": "net",
  "version": "v7.2-rc7",
  "sources": [
    {
      "mechanism": "register_sysctl_init",
      "locator": "net/core/sysctl_net_core.c:sysctl_core_init",
      "interface": "sysctl",
      "path_prefix": "/proc/sys/net/core",
      "table": "net_core_table"
    },
    {
      "mechanism": "register_sysctl_init",
      "locator": "net/ipv4/sysctl_net_ipv4.c:sysctl_ipv4_init",
      "interface": "sysctl",
      "path_prefix": "/proc/sys/net/ipv4",
      "table": "ipv4_table"
    },
    {
      "mechanism": "register_sysctl_init",
      "locator": "net/ipv6/sysctl_net_ipv6.c:ipv6_sysctl_net_init",
      "interface": "sysctl",
      "path_prefix": "/proc/sys/net/ipv6",
      "table": "ipv6_table_template"
    },
    {
      "mechanism": "cftype",
      "locator": "net/core/netclassid_cgroup.c:net_cls_cgrp_subsys",
      "interface": "cgroup",
      "path_prefix": "/sys/fs/cgroup/net_cls.<name>",
      "filter": {"cftype_locator": "net/core/netclassid_cgroup.c:ss_files"},
      "names": ["classid"],
      "config": ["CONFIG_CGROUP_NET_CLASSID"]
    },
    {
      "mechanism": "proc_create_seq",
      "locator": "net/core/net-procfs.c:dev_proc_net_init",
      "interface": "proc",
      "path_prefix": "/proc/net",
      "names": ["softnet_stat"]
    },
    {
      "mechanism": "__setup",
      "locator": "net/core/sysctl_net_core.c:fb_tunnels_only_for_init_net_sysctl_setup",
      "interface": "cmdline",
      "path_prefix": "kernel cmdline",
      "param": "fb_tunnels"
    },
    {
      "mechanism": "__setup",
      "locator": "net/ipv4/tcp_metrics.c:set_tcpmhash_entries",
      "interface": "cmdline",
      "path_prefix": "kernel cmdline",
      "param": "tcpmhash_entries"
    },
    {
      "mechanism": "__setup",
      "locator": "net/ipv4/udp.c:set_uhash_entries",
      "interface": "cmdline",
      "path_prefix": "kernel cmdline",
      "param": "uhash_entries"
    },
    {
      "mechanism": "__setup",
      "locator": "net/ipv4/tcp.c:set_thash_entries",
      "interface": "cmdline",
      "path_prefix": "kernel cmdline",
      "param": "thash_entries"
    },
    {
      "mechanism": "__setup",
      "locator": "net/ipv4/ipconfig.c:set_carrier_timeout",
      "interface": "cmdline",
      "path_prefix": "kernel cmdline",
      "param": "carrier_timeout"
    }
  ]
}
